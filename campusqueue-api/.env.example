# Firebase ENV Setup
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-example@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"

# Firebase console project settings, Web API Key
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
# Comma-separated exact browser origins allowed to call the API
ALLOWED_WEB_ORIGINS=http://localhost:8081
# Development demo accounts only
ENABLE_DEMO_LOGIN=false
